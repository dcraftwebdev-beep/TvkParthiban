# Copy to .env and edit.

# ---------- Vercel + Supabase (production) ----------
# Set these as Environment Variables in the Vercel project (Settings -> Environment Variables).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=            # Supabase -> Project Settings -> API -> service_role key. Keep it secret, never commit it.
ADMIN_PASSWORD=change-me-please  # login for /#/admin
ADMIN_SECRET=                    # any long random text, signs admin sessions
PUBLIC_URL=https://tvkparthibankattur.vercel.app
ADMIN_WHATSAPP=7603959394        # numbers that get an alert for every new complaint (comma separated)
ID_PREFIX=TVK38

# ---------- WhatsApp worker (runs on a PC or server that stays on) ----------
# Full path to the built whatsapp-mcp, e.g. C:/tools/whatsapp-mcp/dist/index.js
WHATSAPP_MCP_PATH=

# ---------- Local development only (npm run server uses SQLite, no Supabase needed) ----------
PORT=8787
NOTIFY_PROVIDER=console
