# Copy to .env and edit. Start with: npm run server
PORT=8787
PUBLIC_URL=http://localhost:5188
ID_PREFIX=TVK38

# Admin panel login (open /#/admin)
ADMIN_PASSWORD=change-me-please

# WhatsApp notifications
#   console = only print messages in the server terminal (default)
#   mcp     = send through dynamolabs/whatsapp-mcp (see README-BACKEND.md)
NOTIFY_PROVIDER=console
# Full path to the built MCP server, e.g. C:/tools/whatsapp-mcp/dist/index.js
WHATSAPP_MCP_PATH=
# Admin numbers that get a message for every new complaint (comma separated, with or without 91)
ADMIN_WHATSAPP=7603959394
